{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abelmathews707/service-manual-extractor/blob/main/schemas/applicability-review-v1.schema.json",
  "title": "Applicability review overlay v1",
  "type": "object", "additionalProperties": false,
  "required": ["contract", "revision", "vocabulary_revision", "evidence_snapshots", "policy_version", "events"],
  "properties": {
    "contract": {"const": "applicability-review/v1"},
    "revision": {"$ref": "#/$defs/sha"},
    "vocabulary_revision": {"$ref": "#/$defs/sha"},
    "evidence_snapshots": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["source_id", "revision"], "properties": {"source_id": {"type": "string", "pattern": "^src_[0-9a-f]{32}$"}, "revision": {"$ref": "#/$defs/sha"}}}},
    "policy_version": {"const": "vehicle-applicability-policy/v1"},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {"id": {"type": "string", "pattern": "^ev_[0-9a-f]{32}$"}, "digest": {"$ref": "#/$defs/sha"}}
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "action", "proposal_id", "subject_id", "relation", "target_configuration_ids", "evidence_bindings", "source_id", "evidence_revision", "vocabulary_revision", "policy_version", "reviewer", "timestamp", "reason"],
      "properties": {
        "id": {"type": "string", "pattern": "^review_[0-9a-f]{32}$"},
        "action": {"enum": ["propose", "accept", "reject", "revoke", "supersede"]},
        "proposal_id": {"type": "string", "minLength": 1},
        "subject_id": {"type": "string", "pattern": "^(pub|doc|unit)_[0-9a-f]{32}$"},
        "relation": {"enum": ["section_applies", "part_fits", "part_mentioned", "duplicate_content", "same_edition"]},
        "target_configuration_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^cfg_[0-9a-f]{32}$"}},
        "evidence_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/binding"}},
        "source_id": {"type": "string", "pattern": "^src_[0-9a-f]{32}$"},
        "evidence_revision": {"$ref": "#/$defs/sha"},
        "vocabulary_revision": {"$ref": "#/$defs/sha"},
        "policy_version": {"type": "string", "minLength": 1},
        "reviewer": {"type": "string", "minLength": 1}, "timestamp": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "prior_event_id": {"type": "string", "pattern": "^review_[0-9a-f]{32}$"}
      },
      "allOf": [{"if": {"properties": {"action": {"const": "propose"}}}, "then": {"not": {"required": ["prior_event_id"]}}, "else": {"required": ["prior_event_id"]}}]
    }
  }
}
