{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abelmathews707/service-manual-extractor/blob/main/schemas/structured-evidence-v1.schema.json",
  "title": "Typed source-bound evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "revision",
    "records"
  ],
  "properties": {
    "contract": {
      "const": "structured-evidence/v1"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rid": {
      "type": "string",
      "pattern": "^record_[0-9a-f]{32}$"
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "enum": [
            "path",
            "page"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "fragment": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "quote",
            "prefix",
            "suffix"
          ],
          "properties": {
            "kind": {
              "const": "text_quote"
            },
            "quote": {
              "type": "string",
              "minLength": 1
            },
            "prefix": {
              "type": "string"
            },
            "suffix": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "selector"
          ],
          "properties": {
            "kind": {
              "const": "html"
            },
            "selector": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "page",
            "bbox"
          ],
          "properties": {
            "kind": {
              "const": "pdf_region"
            },
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "bbox": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minItems": 4,
              "maxItems": 4
            }
          }
        }
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_sha256",
        "generation_sha256",
        "content_sha256",
        "evidence_revision",
        "unit_id",
        "document_id",
        "original_sha256",
        "citation",
        "provenance",
        "extraction_version"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^src_[0-9a-f]{32}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "generation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "unit_id": {
          "type": "string",
          "pattern": "^unit_[0-9a-f]{32}$"
        },
        "document_id": {
          "type": "string",
          "pattern": "^doc_[0-9a-f]{32}$"
        },
        "original_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "citation": {
          "$ref": "#/$defs/citation"
        },
        "provenance": {
          "enum": [
            "native",
            "ocr",
            "catalog"
          ]
        },
        "extraction_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vocabulary_revision",
        "policy_version",
        "configuration_ids"
      ],
      "properties": {
        "vocabulary_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_version": {
          "const": "vehicle-applicability-policy/v1"
        },
        "configuration_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^cfg_[0-9a-f]{32}$"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "missing"
      ],
      "properties": {
        "state": {
          "enum": [
            "complete",
            "incomplete",
            "ambiguous"
          ]
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "normalized": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "maximum",
        "unit"
      ],
      "properties": {
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "quantity",
        "values"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "condition",
              "original_value",
              "original_unit"
            ],
            "properties": {
              "condition": {
                "type": "string",
                "minLength": 1
              },
              "original_value": {
                "type": "string",
                "minLength": 1
              },
              "original_unit": {
                "type": "string",
                "minLength": 1
              },
              "normalized": {
                "$ref": "#/$defs/normalized"
              }
            }
          }
        }
      }
    },
    "part_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier_original",
        "namespace",
        "relationship"
      ],
      "properties": {
        "identifier_original": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "relationship": {
          "enum": [
            "mentioned",
            "fits",
            "supersedes"
          ]
        },
        "target_identifier_original": {
          "type": "string",
          "minLength": 1
        },
        "fits_configuration_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^cfg_[0-9a-f]{32}$"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "procedure_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "instruction",
        "tool_ids",
        "next_record_ids"
      ],
      "properties": {
        "step_label": {"type": "string", "minLength": 1},
        "numbering_style": {"enum": ["1", "a", "A"]},
        "parent_record_id": {"type": "string", "pattern": "^record_[0-9a-f]{32}$"},
        "substep_record_ids": {
          "type": "array", "minItems": 0, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^record_[0-9a-f]{32}$"}
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "tool_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^record_[0-9a-f]{32}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "next_record_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^record_[0-9a-f]{32}$"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "diagnostic_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_kind",
        "operation",
        "expected_results",
        "required_branch_labels"
      ],
      "properties": {
        "node_kind": {
          "enum": [
            "entry",
            "test",
            "decision",
            "outcome"
          ]
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "expected_results": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "required_branch_labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "diagnostic_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_record_id",
        "to_record_id",
        "label",
        "condition"
      ],
      "properties": {
        "from_record_id": {
          "type": "string",
          "pattern": "^record_[0-9a-f]{32}$"
        },
        "to_record_id": {
          "type": "string",
          "pattern": "^record_[0-9a-f]{32}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "required_operation"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "required_operation": {
          "type": "string",
          "minLength": 1
        },
        "identifier_original": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "instruction"
      ],
      "properties": {
        "severity": {
          "enum": [
            "warning",
            "caution",
            "note"
          ]
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "caption_original"
      ],
      "properties": {
        "kind": {
          "enum": [
            "table",
            "figure",
            "text"
          ]
        },
        "caption_original": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation",
        "target_record_id",
        "condition"
      ],
      "properties": {
        "relation": {
          "enum": [
            "prerequisite",
            "next_step",
            "diagram_for",
            "specification_for",
            "cross_reference"
          ]
        },
        "target_record_id": {
          "type": "string",
          "pattern": "^record_[0-9a-f]{32}$"
        },
        "condition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "record_sha256",
        "type",
        "binding",
        "locator",
        "original_text",
        "applicability",
        "conditions",
        "context_record_ids",
        "completeness",
        "payload"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^record_[0-9a-f]{32}$"
        },
        "record_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "type": {
          "enum": [
            "specification",
            "part_reference",
            "procedure_step",
            "diagnostic_node",
            "diagnostic_edge",
            "tool",
            "warning",
            "region",
            "relationship"
          ]
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "original_text": {
          "type": "string",
          "minLength": 1
        },
        "applicability": {
          "$ref": "#/$defs/applicability"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "context_record_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^record_[0-9a-f]{32}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "completeness": {
          "$ref": "#/$defs/completeness"
        },
        "payload": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "type": {
                  "const": "specification"
                },
                "payload": {
                  "$ref": "#/$defs/specification"
                }
              },
              "required": [
                "type",
                "payload"
              ]
            },
            {
              "properties": {
                "type": {
                  "const": "part_reference"
                },
                "payload": {
                  "$ref": "#/$defs/part_reference"
                }
              },
              "required": [
                "type",
                "payload"
              ]
            },
            {
              "properties": {
                "type": {
                  "const": "procedure_step"
                },
                "payload": {
                  "$ref": "#/$defs/procedure_step"
                }
              },
              "required": [
                "type",
                "payload"
              ]
            },
            {
              "properties": {
                "type": {
                  "const": "diagnostic_node"
                },
                "payload": {
                  "$ref": "#/$defs/diagnostic_node"
                }
              },
              "required": [
                "type",
                "payload"
              ]
            },
            {
              "properties": {
                "type": {
                  "const": "diagnostic_edge"
                },
                "payload": {
                  "$ref": "#/$defs/diagnostic_edge"
                }
              },
              "required": [
                "type",
                "payload"
              ]
            },
            {
              "properties": {
                "type": {
                  "const": "tool"
                },
                "payload": {
                  "$ref": "#/$defs/tool"
                }
              },
              "required": [
                "type",
                "payload"
              ]
            },
            {
              "properties": {
                "type": {
                  "const": "warning"
                },
                "payload": {
                  "$ref": "#/$defs/warning"
                }
              },
              "required": [
                "type",
                "payload"
              ]
            },
            {
              "properties": {
                "type": {
                  "const": "region"
                },
                "payload": {
                  "$ref": "#/$defs/region"
                }
              },
              "required": [
                "type",
                "payload"
              ]
            },
            {
              "properties": {
                "type": {
                  "const": "relationship"
                },
                "payload": {
                  "$ref": "#/$defs/relationship"
                }
              },
              "required": [
                "type",
                "payload"
              ]
            }
          ]
        }
      ]
    }
  }
}
