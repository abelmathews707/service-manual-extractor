{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abelmathews707/service-manual-extractor/blob/main/schemas/service-manual-manifest-v1.schema.json",
  "title": "Service Manual Extraction Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "source", "publications"],
  "properties": {
    "contract": {"const": "service-manual-manifest/v1"},
    "source": {"$ref": "#/$defs/source"},
    "publications": {
      "type": "array",
      "items": {"$ref": "#/$defs/publication"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "format", "container", "identity", "sha256", "status",
        "failures", "extractor"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^src_[0-9a-f]{32}$"},
        "format": {
          "enum": [
            "ford_tsp_disc_v1",
            "ford_tsp_disc_v2",
            "workshop_manuals_html_v1",
            "pdf_collection_v1"
          ]
        },
        "container": {
          "enum": ["directory", "zip", "disc", "disc_image", "file_collection"]
        },
        "identity": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000]+$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["complete", "partial", "failed"]},
        "failures": {
          "type": "array",
          "items": {"$ref": "#/$defs/failure"}
        },
        "extractor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "revision"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "revision": {"type": "string", "minLength": 1}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "complete"}}},
          "then": {"properties": {"failures": {"maxItems": 0}}},
          "else": {"properties": {"failures": {"minItems": 1}}}
        }
      ]
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/relativePath"}
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "statement", "source_path"],
      "properties": {
        "level": {"enum": ["publication", "document", "table", "figure"]},
        "statement": {"type": "string", "minLength": 1},
        "source_path": {"$ref": "#/$defs/relativePath"},
        "selector": {"type": "string", "minLength": 1}
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": {"enum": ["path", "page"]},
        "path": {"$ref": "#/$defs/relativePath"},
        "fragment": {"type": "string", "minLength": 1},
        "page": {"type": "integer", "minimum": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "page"}}},
          "then": {"required": ["page"]},
          "else": {"not": {"required": ["page"]}}
        }
      ]
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provenance"],
      "properties": {
        "provenance": {"enum": ["native", "ocr", "none"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "derived_from_sha256": {"$ref": "#/$defs/sha256"},
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1}
          }
        }
      },
      "oneOf": [
        {
          "properties": {"provenance": {"const": "none"}},
          "not": {"anyOf": [
            {"required": ["sha256"]},
            {"required": ["derived_from_sha256"]},
            {"required": ["tool"]}
          ]}
        },
        {
          "required": ["sha256"],
          "properties": {"provenance": {"const": "native"}},
          "not": {"anyOf": [
            {"required": ["derived_from_sha256"]},
            {"required": ["tool"]}
          ]}
        },
        {
          "required": ["sha256", "derived_from_sha256", "tool"],
          "properties": {"provenance": {"const": "ocr"}}
        }
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "status": {
          "enum": ["resolved", "missing", "outside_selection", "unavailable_by_source"]
        },
        "target_id": {"type": "string", "pattern": "^doc_[0-9a-f]{32}$"},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "resolved"}}},
          "then": {"required": ["target_id"], "not": {"required": ["reason"]}},
          "else": {"required": ["reason"], "not": {"required": ["target_id"]}}
        }
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "media_type"],
      "properties": {
        "id": {"type": "string", "pattern": "^asset_[0-9a-f]{32}$"},
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "media_type": {"type": "string", "minLength": 1},
        "caption": {"type": "string"}
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "path", "title", "content_sha256", "text", "citations",
        "applicability", "references", "assets"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^doc_[0-9a-f]{32}$"},
        "path": {"$ref": "#/$defs/relativePath"},
        "title": {"type": "string", "minLength": 1},
        "breadcrumbs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "text": {"$ref": "#/$defs/text"},
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/citation"}
        },
        "applicability": {
          "type": "array",
          "items": {"$ref": "#/$defs/applicability"}
        },
        "references": {
          "type": "array",
          "items": {"$ref": "#/$defs/reference"}
        },
        "assets": {
          "type": "array",
          "items": {"$ref": "#/$defs/asset"}
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_path", "title", "kind", "applicability", "documents"],
      "properties": {
        "id": {"type": "string", "pattern": "^pub_[0-9a-f]{32}$"},
        "source_path": {"$ref": "#/$defs/relativePath"},
        "title": {"type": "string", "minLength": 1},
        "kind": {
          "enum": ["workshop", "wiring", "diagnostics", "owner", "reference", "unknown"]
        },
        "applicability": {
          "type": "array",
          "items": {
            "allOf": [
              {"$ref": "#/$defs/applicability"},
              {"properties": {"level": {"const": "publication"}}}
            ]
          }
        },
        "documents": {
          "type": "array",
          "items": {"$ref": "#/$defs/document"}
        }
      }
    }
  }
}
